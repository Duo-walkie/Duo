{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "userDevices": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "userSettings": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "userEngagement": {
      ".read": false,
      ".write": false
    },
    "groups": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        ".write": false
      }
    },
    "groupMembers": {
      "$groupId": {
        ".read": "auth != null && data.child(auth.uid).child('memberState').val() == 'active'",
        ".write": false
      }
    },
    "userGroups": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": false
      }
    },
    "userGroupIndexVersion": {
      ".read": false,
      ".write": false
    },
    "groupInvites": {
      ".indexOn": ["groupId", "inviteCodeHash"],
      ".read": false,
      ".write": false
    },
    "inviteCodeIndex": {
      ".read": false,
      ".write": false
    },
    "groupLifecycleLocks": {
      ".read": false,
      ".write": false
    },
    "livekitRooms": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        ".write": false
      }
    },
    "memberAvailability": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        "$userId": {
          ".write": "auth != null && auth.uid == $userId && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'"
        }
      }
    },
    "mediaVolume": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        "$userId": {
          ".write": "auth != null && auth.uid == $userId && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'"
        }
      }
    },
    "chatUnread": {
      "$groupId": {
        "$userId": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId"
        }
      }
    },
    "groupMessages": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        ".indexOn": ["createdAt"],
        "$messageId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active' && ((!data.exists() && newData.child('senderUserId').val() == auth.uid) || (data.exists() && data.child('senderUserId').val() == auth.uid))"
        }
      }
    },
    "appServiceSessions": {
      ".indexOn": ["groupId"],
      "$sessionId": {
        ".read": "auth != null && data.child('userId').val() == auth.uid",
        ".write": "auth != null && ((data.exists() && data.child('userId').val() == auth.uid) || (!data.exists() && newData.child('userId').val() == auth.uid)) && root.child('groupMembers').child(newData.child('groupId').val()).child(auth.uid).child('memberState').val() == 'active'"
      }
    },
    "livekitSessions": {
      ".indexOn": ["groupId"],
      "$sessionId": {
        ".read": "auth != null && data.child('userId').val() == auth.uid",
        ".write": "auth != null && ((data.exists() && data.child('userId').val() == auth.uid) || (!data.exists() && newData.child('userId').val() == auth.uid)) && root.child('groupMembers').child(newData.child('groupId').val()).child(auth.uid).child('memberState').val() == 'active'"
      }
    },
    "notificationEvents": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        ".write": false
      }
    },
    "emojiBursts": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        ".indexOn": ["createdAt"],
        "$burstId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active' && ((!data.exists() && newData.child('senderUserId').val() == auth.uid) || (data.exists() && data.child('senderUserId').val() == auth.uid))"
        }
      }
    },
    "notificationDeliveries": {
      "$notificationEventId": {
        ".read": "auth != null && (data.child('senderUserId').val() == auth.uid || data.child('recipientUserId').val() == auth.uid)",
        ".write": "auth != null && newData.child('recipientUserId').val() == auth.uid"
      }
    },
    "userNudgeDeliveries": {
      "$senderUserId": {
        ".read": "auth != null && auth.uid == $senderUserId",
        "$eventId": {
          "$recipientUserId": {
            ".write": "auth != null && auth.uid == $recipientUserId",
            ".validate": "newData.hasChildren(['eventId', 'status', 'senderUserId', 'recipientUserId']) && newData.child('eventId').val() == $eventId && newData.child('senderUserId').val() == $senderUserId && newData.child('recipientUserId').val() == $recipientUserId && (newData.child('status').val() == 'played' || newData.child('status').val() == 'failed')"
          }
        }
      }
    },
    "voiceNudges": {
      ".indexOn": ["groupId"],
      ".read": false,
      ".write": false
    },
    "livekitTokenIssuances": {
      ".indexOn": ["groupId"],
      ".read": false,
      ".write": false
    },
    "talkLocks": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active' && ((!newData.exists() && data.child('holderUserId').val() == auth.uid) || (newData.exists() && newData.child('holderUserId').val() == auth.uid))"
      }
    },
    "talkSessions": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        "$talkSessionId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active' && ((!data.exists() && newData.child('speakerUserId').val() == auth.uid) || (data.exists() && data.child('speakerUserId').val() == auth.uid))"
        }
      }
    },
    "statusEvents": {
      "$groupId": {
        ".read": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
        "$eventId": {
          ".write": "auth != null && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active' && newData.child('userId').val() == auth.uid"
        }
      }
    },
    "dailyUsage": {
      "$groupId": {
        "$userId": {
          ".read": "auth != null && auth.uid == $userId && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'",
          ".write": "auth != null && auth.uid == $userId && root.child('groupMembers').child($groupId).child(auth.uid).child('memberState').val() == 'active'"
        }
      }
    }
  }
}
