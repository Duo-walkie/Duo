NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# LiveKit token signing. Do not commit real values.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Firebase Admin SDK.
# Option A: set GOOGLE_APPLICATION_CREDENTIALS outside this file.
# Option B: use the explicit service-account fields below.
FIREBASE_PROJECT_ID=replace-me
FIREBASE_CLIENT_EMAIL=replace-me
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
# Use the exact Realtime Database URL from Firebase Console.
# Region-based databases usually look like:
# https://your-project-id-default-rtdb.region.firebasedatabase.app
FIREBASE_DATABASE_URL=https://replace-me-default-rtdb.region.firebasedatabase.app
# Private bucket used for short-lived voice nudges.
FIREBASE_STORAGE_BUCKET=replace-me.firebasestorage.app

# Public HTTPS origin of this API. Sent to Android devices for short-lived
# voice-nudge download and acknowledgement callbacks.
PUBLIC_API_BASE_URL=https://api.example.com

# Public base used in shared group links. It must end in /invite and its host
# must match the Android App Link host in AndroidManifest.xml.
PUBLIC_INVITE_BASE_URL=https://api.example.com/invite

# Comma-separated SHA-256 signing-certificate fingerprints for Android App
# Link verification (Play App Signing plus any internal/testing certificate).
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=

# Nudge abuse protection. Defaults allow a complete foreground/background/
# removed-from-recents acceptance pass without silently blocking the sixth send.
NUDGE_RATE_LIMIT_WINDOW_SECONDS=600
NUDGE_RATE_LIMIT_MAX_PER_GROUP=30
NUDGE_RECIPIENT_COOLDOWN_SECONDS=5

# Per-type cooldowns: minimum seconds between a sender's own nudges of the
# same type, independent of the recipient/group limits above.
NUDGE_COOLDOWN_RING_SECONDS=0
NUDGE_COOLDOWN_VOICE_SECONDS=60
NUDGE_COOLDOWN_PUSH_SECONDS=10

# Anti-spam guard: max nudges of any type a single sender may fire within
# this rolling window.
NUDGE_SPAM_WINDOW_SECONDS=300
NUDGE_SPAM_MAX_PER_WINDOW=10

# SHA-256 hashes of high-entropy developer redeem codes, comma-separated.
# Generate one with:
# printf %s 'YOUR-LONG-CODE' | tr '[:lower:]' '[:upper:]' | shasum -a 256
SUBSCRIPTION_REDEEM_CODE_HASHES=

# Comma-separated HTTPS origins for future browser/admin clients.
CORS_ORIGINS=

# Shared secret for POST /v1/internal/jobs/* (Cloud Scheduler / cron).
# Generate with: openssl rand -hex 32
INTERNAL_JOB_SECRET=

