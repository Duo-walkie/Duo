<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Soft radial glow behind the sheet, near the top edge of the container -->
    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_rim_glow" />

    <LinearLayout
        android:id="@+id/quick_record_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_quick_record_sheet"
        android:paddingTop="24dp"
        android:paddingBottom="36dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_horizontal">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_quick_record_bar" />

        <ImageView
            android:id="@+id/logo_bars"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="14dp"
            android:src="@drawable/ic_duo_bars" />

        <TextView
            android:id="@+id/target_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Sending a voice note"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/orb_glow"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orb_glow" />

            <app.oneone.one_one_app.AssistantOrbView
                android:id="@+id/visualizer"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="Listening…"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_cancel"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_quick_record_button"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_decline"
                android:contentDescription="Cancel" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_widget_mic"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_accept"
                android:tint="@color/widget_accent_on"
                android:contentDescription="Send voice note" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
