<?xml version="1.0" encoding="utf-8"?>
<!-- Compact: logo + name + next on top, mic + actions pinned to the bottom. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass_card"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/logo_bars"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Duo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_logo" />

        <TextView
            android:id="@+id/group_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Friends"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="LIVE"
            android:textColor="@color/widget_online_green"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_widget_btn_oval"
            android:clickable="true"
            android:contentDescription="Next group"
            android:focusable="true"
            android:paddingLeft="6dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next_png" />
    </LinearLayout>

    <!-- Shared ids for renderer; hidden on small. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/avatar_1"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/avatar_2"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/avatar_3"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/avatar_4"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/avatar_5"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/avatar_overflow"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/avatar_1_mono"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/avatar_2_mono"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/avatar_3_mono"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/avatar_4_mono"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/avatar_5_mono"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actions_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btn_mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_widget_mic_oval"
            android:clickable="true"
            android:contentDescription="Voice nudge"
            android:focusable="true"
            android:paddingLeft="13dp"
            android:paddingTop="13dp"
            android:paddingRight="13dp"
            android:paddingBottom="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_mic_png" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_decline"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_widget_btn_oval"
                android:clickable="true"
                android:contentDescription="Decline"
                android:focusable="true"
                android:paddingLeft="7dp"
                android:paddingTop="7dp"
                android:paddingRight="7dp"
                android:paddingBottom="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_decline_png"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btn_ring"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_widget_btn_accent_oval"
                android:clickable="true"
                android:contentDescription="Ring"
                android:focusable="true"
                android:paddingLeft="7dp"
                android:paddingTop="7dp"
                android:paddingRight="7dp"
                android:paddingBottom="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_ring_png" />

            <ImageView
                android:id="@+id/btn_notify"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_widget_btn_accent_oval"
                android:clickable="true"
                android:contentDescription="Notify"
                android:focusable="true"
                android:paddingLeft="7dp"
                android:paddingTop="7dp"
                android:paddingRight="7dp"
                android:paddingBottom="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_notify_png" />

            <ImageView
                android:id="@+id/btn_accept"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_widget_btn_oval"
                android:clickable="true"
                android:contentDescription="Accept"
                android:focusable="true"
                android:paddingLeft="7dp"
                android:paddingTop="7dp"
                android:paddingRight="7dp"
                android:paddingBottom="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_accept_png"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/actions_column"
        android:layout_below="@id/header_row"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="Tap mic to nudge"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp" />
</RelativeLayout>
