<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same brand yellow as Flutter loading underlays and the welcome
         screen (Color(0xffF8BE03) in Dart) so a premature native-splash
         dismiss still matches the window, without a second logo. -->
    <color name="splash_background">#F8BE03</color>
    <color name="notification_accent">#F8BE03</color>

    <!-- Duo home-screen widget tokens. Accent matches the app's brand
         yellow everywhere (splash, start gate) instead of a one-off red. -->
    <color name="widget_bg">#0D0D0D</color>
    <color name="widget_surface">#1A1A1A</color>
    <color name="widget_text_primary">#F0EDE8</color>
    <color name="widget_text_secondary">#7A7670</color>
    <color name="widget_accent_default">#F8BE03</color>
    <color name="widget_accent_on">#1A1400</color>
    <color name="widget_online_green">#34D399</color>

    <!-- Glass tokens: a translucent dark card (instead of flat opaque
         black) so the launcher wallpaper reads faintly through the widget,
         with frosted chip surfaces for the buttons sitting on top of it. -->
    <color name="widget_glass_card_fill">#E6151515</color>
    <color name="widget_glass_card_border">#29FFFFFF</color>
    <color name="widget_chip_glass_fill">#1FFFFFFF</color>
    <color name="widget_chip_glass_border">#3DFFFFFF</color>
    <!-- Grey (not white) mic glyph — reads far better against the solid
         yellow mic button than white/near-black did. -->
    <color name="widget_mic_icon_grey">#2E2C28</color>
</resources>
