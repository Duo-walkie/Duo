<?xml version="1.0" encoding="utf-8"?>
<!-- Widget root background: a translucent rounded card rather than flat
     opaque black, so it reads as sitting on the user's wallpaper (a
     "glassy" surface) while staying dark enough for our light text/icons
     to keep proper contrast. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_glass_card_fill" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/widget_glass_card_border" />
</shape>
