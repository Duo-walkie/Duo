<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass chip for ring/notify — same translucent fill as the
     neutral chip, but with a faint brand-yellow rim so they read as
     "nudge" siblings of the mic without competing with its solid fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/widget_chip_glass_fill" />
    <stroke android:width="1.2dp" android:color="#66F8BE03" />
</shape>
